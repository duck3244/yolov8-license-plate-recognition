# backend/.env.example
# pydantic-settings 가 backend/.env 를 자동 로드한다.
# 실제 .env 파일은 절대 git 에 커밋하지 말 것.

# 운영에서는 반드시 강력한 임의값으로 변경 (예: python -c "import secrets; print(secrets.token_hex(32))")
LPR_SECRET_KEY=change-me-in-production

# 서버 바인딩 — 단일 사용자 MVP 는 localhost 권장
HOST=127.0.0.1
PORT=8000

# 모델 / 추론
CONFIDENCE_THRESHOLD=0.3
OCR_ENGINE=auto

# 업로드 정책
MAX_UPLOAD_MB=16
DELETE_AFTER_PROCESS=true
CLEANUP_AGE_HOURS=24

# 로그 레벨
LOG_LEVEL=INFO
